{
  "name": "nimbus-mail",
  "productName": "Nimbus",
  "version": "0.1.0",
  "description": "Client email minimale per Windows",
  "main": "./out/main/index.js",
  "author": "Nimbus",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run build && electron-builder --win --config electron-builder.config.cjs",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.config.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/mailparser": "^3.4.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dompurify": "^3.2.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^1.74.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.0"
  }
}
